{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Phoenix",
    "version": "0.1.0",
    "identifier": "io.phoenix-arm.tools",
    "build": {
        "frontendDist": "../dist",
        "devUrl": "http://localhost:1420",
        "beforeDevCommand": "npm run dev",
        "beforeBuildCommand": "npm run build"
    },
    "app": {
        "windows": [{
            "title": "Phoenix - TV Box Liberation",
            "width": 1200,
            "height": 800,
            "resizable": true,
            "center": true,
            "decorations": true
        }],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": ["nsis", "msi", "deb", "appimage"],
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ]
    }
}