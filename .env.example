# Phoenix Tools - Environment Configuration

# User context (Linux only - auto-detects UID/GID)
# UID=1000
# GID=1000

# Display forwarding for GUI (Linux X11)
DISPLAY=:0

# Rust environment
RUST_LOG=info,phoenix=debug
RUST_BACKTRACE=1

# Development options
TAURI_ENV_DEBUG=true
TAURI_ENV_PLATFORM=linux

# Node.js options
NODE_ENV=development

# Hardware access (uncomment devices you have)
# TTY_DEVICE=/dev/ttyUSB0  # UART adapter
# USB_DEVICE=/dev/bus/usb   # USB devices
