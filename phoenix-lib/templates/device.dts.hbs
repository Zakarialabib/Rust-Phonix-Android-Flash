// Device Tree Source Template for Phoenix OS
// Generated by phoenix-tools

/dts-v1/;

#include "{{reference_dtb}}"

/ {
    compatible = "phoenix,{{device_name}}", "amlogic,{{soc}}", "amlogic,{{soc_family}}";
    model = "{{device_name}}";

{{#if led_gpio}}
    leds {
        compatible = "gpio-leds";

        power_led {
            label = "power";
            gpios = <{{led_gpio}}>;
            default-state = "on";
        };
    };
{{/if}}

    memory@0 {
        device_type = "memory";
        reg = <0x0 0x0 0x0 {{memory_size_mb}}0000>;
    };
};

{{#if has_wifi}}
&sd_emmc_a {
    status = "okay";

    brcmf: wifi@1 {
        compatible = "brcm,bcm4329-fmac";
    };
};
{{/if}}

{{#if has_ethernet}}
&ethmac {
    status = "okay";
    phy-mode = "rmii";
};
{{/if}}
